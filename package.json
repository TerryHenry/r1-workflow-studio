{
  "name": "r1-workflow-studio",
  "version": "1.1.0",
  "private": true,
  "description": "R1 Workflow Studio: build RUCKUS One workflows visually, or read Cloudpath workflows and convert them",
  "scripts": {
    "test": "node --test test/*.test.js",
    "report": "node bin/report.js",
    "start": "node bin/ui.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win -c.win.signAndEditExecutable=false",
    "dist": "npm run dist:mac && npm run dist:win",
    "dist:win:full": "electron-builder --win"
  },
  "productName": "R1 Workflow Studio",
  "author": "Terry Henry",
  "main": "electron/main.js",
  "build": {
    "appId": "io.github.terryhenry.r1workflowstudio",
    "productName": "R1 Workflow Studio",
    "copyright": "R1 Workflow Studio",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "crawl/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "R1 Workflow Studio ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "R1 Workflow Studio"
    },
    "artifactName": "R1-Workflow-Studio-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
